---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout>
  <main class="min-h-screen flex flex-col items-center justify-center gap-4 p-6 text-center">
    <h1 class="text-5xl font-semibold">{site.nome}</h1>
    <p class="text-lg opacity-80">{site.estilo} · {site.cidade}</p>
    <!-- style="..." = CSS direto, usado aqui porque a cor vem de uma variável -->
    <a class="rounded-full px-6 py-3 font-semibold text-black" style="background: var(--cor-destaque)" href="#">
      Pedir orçamento
    </a>
  </main>
</Layout>